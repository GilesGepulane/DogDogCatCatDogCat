<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐾 Pet Battle"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the pet you like less to replace it!"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- DOG VS DOG -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐶 Dog vs Dog"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/dogImage1"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="First dog" />

                <Button
                    android:id="@+id/replaceDog1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Replace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/dogImage2"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Second dog" />

                <Button
                    android:id="@+id/replaceDog2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Replace" />
            </LinearLayout>
        </LinearLayout>

        <!-- CAT VS CAT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐱 Cat vs Cat"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/catImage1"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="First cat" />

                <Button
                    android:id="@+id/replaceCat1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Replace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/catImage2"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Second cat" />

                <Button
                    android:id="@+id/replaceCat2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Replace" />
            </LinearLayout>
        </LinearLayout>

        <!-- CAT VS DOG -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚔️ Cat vs Dog"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/mixedCatImage"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Cat in mixed battle" />

                <Button
                    android:id="@+id/replaceMixedCat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Replace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/mixedDogImage"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Dog in mixed battle" />

                <Button
                    android:id="@+id/replaceMixedDog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Replace" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading images..."
            android:gravity="center"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>